# Copy this file to .env and fill in your token — .env itself is gitignored, never
# committed. Get a token from #ask-platform on Slack (same token ocean-pipeline
# itself uses for JIRA_API_TOKEN — if you already export it in your shell for that,
# you don't need this file at all).
#
# Both JIRA_API_TOKEN and JIRA_EMAIL are required — Jira Cloud's REST API needs Basic
# auth (email:token), not a bare Bearer token; verified directly against the real
# instance, see jira_client.py's module docstring for the full story.
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_BASE_URL=https://fourkites.atlassian.net
