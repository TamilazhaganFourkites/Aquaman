# Copy to .env for `langgraph dev` (LangGraph Studio) and local runs.
FK_AIDEVELOPER_DIR=/absolute/path/to/fk-aideveloper
# Clean runner log is the default. Set to 1 ONLY for the engineer deep-dive
# (raw agent tool calls) — it's noisy and not for stakeholders.
OCEAN_PIPELINE_VERBOSE=0
# OCEAN_PIPELINE_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=...        # or authenticate the `claude` CLI via `ant auth login`

# --- Observability: self-hosted Langfuse (open-source, on FK infra) ---
# Preferred UI for watching a run — NOT LangSmith/smith.langchain.com.
# Creds live in ~/.fourkites-secrets.env (see the FK "Prompt Testing Guide"); the
# pipeline auto-loads that file, so you usually don't set these here. Get keys from Luvkush.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://langfuse.fourkites.com

# Leave LANGSMITH_TRACING unset — we do not export runs to LangSmith's cloud.
